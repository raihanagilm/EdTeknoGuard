APP_NAME="EdTeknoGuard"
APP_ENV=development
APP_PORT=7890
APP_URL="http://localhost:7890"
SECRET_KEY="supersecret-change-in-production"

# Database (MySQL Local - Custom Port)
DB_HOST=127.0.0.1
DB_PORT=33070
DB_USER=root
DB_PASSWORD=
DB_NAME=edteknoguard

# Telegram Bot Alerting
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Bisa beberapa ID (teknisi & grup), pisahkan dengan koma
TELEGRAM_CHAT_IDS=12345678,87654321,-100123456789

# Monitoring Settings
POLLING_INTERVAL_MINUTES=5
WARNING_THRESHOLD_DBM=-26.0
CRITICAL_THRESHOLD_DBM=-27.0
SNMP_SIMULATION_MODE=false

