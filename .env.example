APP_NAME="EdTeknoGuard"
APP_ENV=development
APP_PORT=8000
APP_URL="http://localhost:8000"
SECRET_KEY="supersecret-change-in-production"

# Database (TiDB Cloud - MySQL Engine)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_user
DB_PASSWORD=your_tidb_password
DB_NAME=EdTeknoGuard

# Telegram Bot Alerting
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Bisa beberapa ID (teknisi & grup), pisahkan dengan koma
TELEGRAM_CHAT_IDS=12345678,87654321,-100123456789

# Monitoring Settings
POLLING_INTERVAL_MINUTES=5
WARNING_THRESHOLD_DBM=-26.0
CRITICAL_THRESHOLD_DBM=-32.0
SNMP_SIMULATION_MODE=true
